-std=c23
-Os
-pipe
-D_GNU_SOURCE
-Wall
-Wextra
-Wformat=2
-fstack-protector-strong
-D_FORTIFY_SOURCE=3
-fPIE
-pie
-ffunction-sections
-fdata-sections
-Wl,--gc-sections
-Wl,--as-needed
-Wl,-z,relro
-Wl,-z,now
-s
-DGLIB_VERSION_MIN_REQUIRED=GLIB_VERSION_2_80
-DGLIB_VERSION_MAX_ALLOWED=GLIB_VERSION_2_80
-pthread
-I/usr/include/glib-2.0
-I/usr/lib/glib-2.0/include
-I/usr/include/json-c
src/main.c
src/args.c
src/util.c
src/paths.c
src/log.c
src/json.c
src/db.c
src/regex.c
src/proc.c
src/config.c
src/notify.c
src/index.c
src/reminders.c
src/memories.c
src/dates.c
src/items.c
src/enrich.c
src/capture.c
src/cmd_migrate.c
src/cmd_read.c
src/cmd_maint.c
src/cmd_write.c
src/cmd_setup.c
-lgio-2.0
-lgobject-2.0
-lglib-2.0
-ljson-c
-lsqlite3
-lm
