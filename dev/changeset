#!/usr/bin/env python3
"""Hold changesets to this repository's rules, which the changesets CLI does not know.

`pnpm changeset` writes a changeset and `pnpm version-packages` applies them;
this script only checks. A changeset names the package and its bump, then a
conventional-commit title and an optional body:

    ---
    "omoide": minor
    ---

    feat(library): collections can be renamed from the collection page

The title is `type(scope): what changed`, with a type from TYPES; the scope
names the part of the product and is left out only for a change across all of
it. The bump follows the type: a `feat` is minor, every other type patch, and
major, which only the owner decides, goes with any type. A change that ships
nothing a user would notice is an empty changeset, `pnpm changeset --empty`,
whose title is optional. The changesets skill owns how a title and body are
written.

A change counts as user-facing, and needs a changeset, when it touches a file
under ui/, cli/ or sql/, or manifest.json. Three things do not count: an
AGENTS.md or CLAUDE.md anywhere, cli/fuzz/ (not in the user's build), and a
manifest.json whose only difference is `version`, which is what a release does.
A changed file anywhere else, package.json included, needs none.

Usage:  dev/changeset status [--since <ref>]
            check every pending changeset. With --since, also fail when a
            user-facing file changed between the merge base of <ref> and the
            working tree, but no changeset was added there
        dev/changeset selftest
            run status in throwaway git repositories
Exit:   0 clean, 1 a changeset breaks a rule or --since found a change without
        one, 2 usage error
"""
import json
import os
import pathlib
import re
import shutil
import subprocess
import sys
import tempfile

ROOT = pathlib.Path(__file__).resolve().parent.parent
PENDING = ROOT / ".changeset"
MANIFEST = ROOT / "manifest.json"

PACKAGE = "omoide"
BUMPS = ("patch", "minor", "major")
TYPES = ("feat", "fix", "refactor", "docs", "chore")
TITLE = re.compile(r"^(" + "|".join(TYPES) + r")(\([a-z][a-z0-9-]*(,[a-z][a-z0-9-]*)*\))?: \S.*$")
# The package key as the changesets CLI writes it, or bare, or single-quoted.
ENTRY = re.compile(r"""^(["']?)""" + PACKAGE + r"""\1: *([a-z]+) *$""")
USER_FACING = ("ui/", "cli/", "sql/")
NOT_USER_FACING = ("cli/fuzz/",)
AGENT_FILES = ("AGENTS.md", "CLAUDE.md")


class Malformed(Exception):
    pass


def usage(message: str) -> int:
    print(f"dev/changeset: {message}", file=sys.stderr)
    print("usage: dev/changeset status [--since <ref>]\n"
          "       dev/changeset selftest", file=sys.stderr)
    return 2


def title_error(title: str):
    """Why a title is not `type(scope): what changed`, or None when it is."""
    if not TITLE.match(title):
        return (f"`{title}` is not `type(scope): what changed`, with a type from "
                f"{', '.join(TYPES)} and a lowercase scope")
    return None


def bump_error(bump: str, title: str):
    """Why a bump does not suit its title's type, or None when it does."""
    kind = TITLE.match(title).group(1)
    if bump == "major":
        return None
    if kind == "feat" and bump != "minor":
        return f"a feat is a minor bump, not {bump}"
    if kind != "feat" and bump != "patch":
        return f"a {kind} is a patch bump, not {bump}; minor is for a feat"
    return None


def parse(path: pathlib.Path):
    """(bump, title) of one changeset; bump is None for an empty changeset."""
    text = path.read_text()
    m = re.match(r"\A---\n(.*?)^---\n(.*)\Z", text, re.S | re.M)
    if not m:
        raise Malformed(f"{path.name}: expected a `---` frontmatter, then the title")
    entries = [line for line in m.group(1).splitlines() if line.strip()]
    title = next((line.strip() for line in m.group(2).splitlines() if line.strip()), "")
    bump = None
    if entries:
        entry = ENTRY.match(entries[0])
        if len(entries) != 1 or not entry:
            raise Malformed(f"{path.name}: the frontmatter names one package, `\"{PACKAGE}\": <bump>`")
        bump = entry.group(2)
        if bump == "none":
            raise Malformed(f"{path.name}: a change that ships nothing is an empty changeset, "
                            "pnpm changeset --empty")
        if bump not in BUMPS:
            raise Malformed(f"{path.name}: the bump is one of {', '.join(BUMPS)}, not `{bump}`")
        if not title:
            raise Malformed(f"{path.name}: a {bump} bump needs a title for the changelog")
    if title and title_error(title):
        raise Malformed(f"{path.name}: {title_error(title)}")
    if bump and bump_error(bump, title):
        raise Malformed(f"{path.name}: {bump_error(bump, title)}")
    return bump, title


def pending():
    """Every changeset, parsed, in filename order. The CLI's own README is not one."""
    if not PENDING.is_dir():
        return []
    return [(path, *parse(path)) for path in sorted(PENDING.glob("*.md")) if path.name != "README.md"]


def git(*args) -> str:
    return subprocess.run(["git", "-C", str(ROOT), *args], check=True, capture_output=True,
                          text=True).stdout


def user_facing(path: str, base: str) -> bool:
    if path.rsplit("/", 1)[-1] in AGENT_FILES or path.startswith(NOT_USER_FACING):
        return False
    if path == "manifest.json":
        try:
            old = json.loads(git("show", f"{base}:manifest.json"))
            new = json.loads(MANIFEST.read_text()) if MANIFEST.exists() else None
        except (subprocess.CalledProcessError, json.JSONDecodeError):
            return True
        if new is None:
            return True
        old.pop("version", None)
        new.pop("version", None)
        return old != new
    return path.startswith(USER_FACING)


def gate(ref: str) -> int:
    try:
        base = git("merge-base", ref, "HEAD").strip()
    except subprocess.CalledProcessError as e:
        print(f"dev/changeset: no merge base between {ref} and HEAD: {e.stderr.strip()}", file=sys.stderr)
        return 2
    changed = {}
    for line in git("diff", "--name-status", "--no-renames", base).splitlines():
        status, _, path = line.partition("\t")
        changed[path] = status[0]
    for path in git("ls-files", "--others", "--exclude-standard").splitlines():
        changed[path] = "A"
    added = sorted(p for p, s in changed.items()
                   if s == "A" and p.startswith(".changeset/") and p.endswith(".md")
                   and not p.endswith("/README.md"))
    facing = sorted(p for p in changed if user_facing(p, base))
    if added:
        print(f"since {ref}: changeset added ({', '.join(added)})")
        return 0
    if not facing:
        print(f"since {ref}: no user-facing file changed, so no changeset is needed")
        return 0
    print(f"since {ref}: these user-facing files changed, but no changeset was added:")
    for path in facing:
        print(f"  {path}")
    print("run pnpm changeset, or pnpm changeset --empty for a change users will not notice; "
          "the changesets skill says how to write it")
    return 1


def cmd_status(args) -> int:
    since = None
    it = iter(args)
    for arg in it:
        if arg == "--since":
            since = next(it, None)
            if since is None:
                return usage("--since needs a git ref")
        elif arg.startswith("--since="):
            since = arg.split("=", 1)[1]
        else:
            return usage(f"unknown argument {arg}")
    try:
        changesets = pending()
    except Malformed as e:
        print(f"dev/changeset: {e}", file=sys.stderr)
        return 1
    if not changesets:
        print("no pending changesets")
    else:
        print(f"{len(changesets)} pending:")
        for path, bump, title in changesets:
            print(f"  {bump or 'none':<5}  {path.name}  {title or '(no title)'}")
    return gate(since) if since is not None else 0


def selftest(args) -> int:
    """Run this script, copied into throwaway repositories, and compare what it did."""
    if args:
        return usage(f"selftest takes no arguments, got {' '.join(args)}")
    failures = []
    env = {**os.environ, "GIT_AUTHOR_NAME": "t", "GIT_AUTHOR_EMAIL": "t@example.invalid",
           "GIT_COMMITTER_NAME": "t", "GIT_COMMITTER_EMAIL": "t@example.invalid",
           "GIT_CONFIG_GLOBAL": os.devnull, "GIT_CONFIG_NOSYSTEM": "1"}
    manifest = MANIFEST.read_text()
    version = json.loads(manifest)["version"]

    def expect(name, condition, detail=""):
        if not condition:
            failures.append(f"{name}{': ' + detail if detail else ''}")

    def sh(cwd, *argv):
        return subprocess.run(argv, cwd=cwd, env=env, capture_output=True, text=True)

    def repo(tmp: pathlib.Path) -> pathlib.Path:
        path = pathlib.Path(tempfile.mkdtemp(dir=tmp))
        (path / "dev").mkdir()
        shutil.copy(__file__, path / "dev" / "changeset")
        (path / "manifest.json").write_text(manifest)
        (path / "ui").mkdir()
        (path / "ui" / "A.qml").write_text("Item {}\n")
        (path / ".changeset").mkdir()
        (path / ".changeset" / "README.md").write_text("# Changesets\n")
        sh(path, "git", "init", "-q", "-b", "main")
        commit(path, "base")
        return path

    def tool(cwd, *argv):
        return sh(cwd, sys.executable, "dev/changeset", *argv)

    def commit(cwd, message="change"):
        sh(cwd, "git", "add", "-A")
        sh(cwd, "git", "commit", "-q", "-m", message)

    def changeset(r, name, text):
        (r / ".changeset" / f"{name}.md").write_text(text)

    def status_of(r, text):
        changeset(r, "probe", text)
        out = tool(r, "status")
        (r / ".changeset" / "probe.md").unlink()
        return out

    with tempfile.TemporaryDirectory() as tmp:
        tmp = pathlib.Path(tmp)

        r = repo(tmp)
        out = tool(r, "status")
        expect("status with nothing pending exits 0", out.returncode == 0, out.stderr)
        expect("the CLI's README is not a changeset", "no pending changesets" in out.stdout, out.stdout)
        for key in ('"omoide"', "'omoide'", "omoide"):
            out = status_of(r, f"---\n{key}: patch\n---\n\nfix(ui): a thing broke\n")
            expect(f"status accepts the package written as {key}", out.returncode == 0, out.stderr)
        out = status_of(r, "---\n---\n")
        expect("status accepts an empty changeset", out.returncode == 0, out.stderr)
        out = status_of(r, "---\n---\n\nchore(ui): tidy the grid\n")
        expect("status accepts an empty changeset with a title", out.returncode == 0, out.stderr)
        for label, text in [
            ("an untyped title", '---\n"omoide": patch\n---\n\nFixed a thing.\n'),
            ("an unknown type", '---\n"omoide": patch\n---\n\nperf(ui): faster\n'),
            ("a missing title", '---\n"omoide": patch\n---\n'),
            ("a feat that is not minor", '---\n"omoide": patch\n---\n\nfeat(ui): x can be done\n'),
            ("a minor that is not a feat", '---\n"omoide": minor\n---\n\nfix(ui): x broke\n'),
            ("a none bump", '---\n"omoide": none\n---\n\nchore: nothing\n'),
            ("another package", '---\n"bump": patch\n---\n\nfix(ui): x broke\n'),
            ("two packages", '---\n"omoide": patch\n"other": patch\n---\n\nfix(ui): x broke\n'),
            ("an untyped empty changeset", "---\n---\n\nTidied the grid.\n"),
        ]:
            out = status_of(r, text)
            expect(f"status refuses {label}", out.returncode == 1, out.stdout + out.stderr)
        out = status_of(r, '---\n"omoide": major\n---\n\nrefactor: the old thing is gone\n')
        expect("status accepts a major with any type", out.returncode == 0, out.stderr)

        g = repo(tmp)
        sh(g, "git", "switch", "-q", "-c", "topic")
        out = tool(g, "status", "--since", "main")
        expect("gate passes with no change", out.returncode == 0, out.stdout)
        (g / "ui" / "A.qml").write_text("Item { id: a }\n")
        commit(g)
        out = tool(g, "status", "--since", "main")
        expect("gate fails on a user-facing change without a changeset", out.returncode == 1, out.stdout)
        expect("gate names the file", "ui/A.qml" in out.stdout, out.stdout)
        changeset(g, "happy-lions-jump", '---\n"omoide": patch\n---\n\nfix(ui): a thing broke\n')
        out = tool(g, "status", "--since", "main")
        expect("gate passes on an uncommitted changeset", out.returncode == 0, out.stdout)
        commit(g)
        out = tool(g, "status", "--since", "main")
        expect("gate passes once the changeset is committed", out.returncode == 0, out.stdout)

        d = repo(tmp)
        sh(d, "git", "switch", "-q", "-c", "topic")
        (d / "dev" / "notes").write_text("x\n")
        (d / "ui" / "AGENTS.md").write_text("x\n")
        (d / "package.json").write_text('{"version": "9.9.9"}\n')
        commit(d)
        out = tool(d, "status", "--since", "main")
        expect("gate ignores dev/, AGENTS.md and package.json", out.returncode == 0, out.stdout)
        (d / "manifest.json").write_text(manifest.replace(f'"version": "{version}"', '"version": "9.9.9"'))
        commit(d)
        out = tool(d, "status", "--since", "main")
        expect("gate ignores a version-only manifest change", out.returncode == 0, out.stdout)
        (d / "manifest.json").write_text(manifest.replace('"name": "', '"name": "x', 1))
        commit(d)
        out = tool(d, "status", "--since", "main")
        expect("gate counts any other manifest change", out.returncode == 1, out.stdout)
        (d / "ui" / "A.qml").write_text("Item { id: b }\n")
        commit(d)
        (d / ".changeset" / "README.md").write_text("# Changesets, reworded\n")
        commit(d)
        out = tool(d, "status", "--since", "main")
        expect("gate does not take the CLI's README for a changeset", out.returncode == 1, out.stdout)

    for failure in failures:
        print(f"FAIL  {failure}")
    print(f"selftest: {'ok' if not failures else f'{len(failures)} failed'}")
    return 1 if failures else 0


def main() -> int:
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print(__doc__.strip())
        return 0 if len(sys.argv) >= 2 else 2
    commands = {"status": cmd_status, "selftest": selftest}
    command = commands.get(sys.argv[1])
    if command is None:
        return usage(f"unknown command {sys.argv[1]}; write changesets with pnpm changeset")
    return command(sys.argv[2:])


if __name__ == "__main__":
    sys.exit(main())
