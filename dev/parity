                 "width, height) VALUES ('a-shot', 'm-shot', 'image', ?, ?, 1600, 900)",
                 (rel, thumb))
    block("b-src", "m-shot", 0, "source", {"url": "https://github.com/x/y", "domain": "github.com"})
    block("b-img", "m-shot", 1, "image", {"attachment_id": "a-shot"}, origin="capture")
    block("b-sum", "m-shot", 2, "summary", {"text": "A summary / with a slash"})
