# --- declared differences -----------------------------------------------------

def unwrap_sh(side: dict) -> None:
    """`sh -c "a b c"` read back as the argv the reference stored."""
    def fix(command):
        if isinstance(command, list) and command[:2] == ["sh", "-c"] and len(command) == 3:
            return shlex.split(command[2])
        return command
    for out in side["stdout"] if isinstance(side["stdout"], list) else []:
        if "command" in out:
            out["command"] = fix(out["command"])
    if side["config"] and "ai" in side["config"]:
        side["config"]["ai"]["command"] = fix(side["config"]["ai"].get("command"))


def drop_install_command(side: dict) -> None:
    for out in side["stdout"] if isinstance(side["stdout"], list) else []:
        out.pop("command", None)


def dst_shift(py: dict, c: dict) -> str | None:
    """'in 30 days' crosses the end of DST. The reference added 720 hours to a
    fixed offset, landing an hour off the wall-clock time; C keeps the time."""
    def due(side):
        rows = [json.loads(r) for r in side["db"]["items"]]
        return [r for r in rows if r[4] == "DST check"][0][6]
    py_due = datetime.fromisoformat(due(py).replace("Z", "+00:00"))
    c_due = datetime.fromisoformat(due(c).replace("Z", "+00:00"))
    if c_due - py_due != timedelta(hours=1):
        return f"expected C one hour after Python, got {py_due} vs {c_due}"
    return None


def flood_stopped(side: dict) -> None:
    """The reference only stopped a flooding agent if it was still running when
    it looked, so an agent that printed its megabyte and exited was logged as
    exiting 0. C stops the whole group every time, and says so."""
    side["log"] = [re.sub(r"ai\.exit rc=-9 ", "ai.exit rc=0 ", line) for line in side["log"]
                   if " ai.capped " not in line]


# name: (why, normaliser applied to the C side) or (why, check(py, c) -> error)
EXPECTED = {
    "setup-ai-custom": ("a custom command is stored as sh -c", ("c", unwrap_sh)),
    "install": ("install also links ~/.local/bin/omoide", ("c", drop_install_command)),
    "install-enable-fails": ("install also links ~/.local/bin/omoide", ("c", drop_install_command)),
    "item-add-dst": ("calendar steps keep the wall-clock time across DST", ("check", dst_shift)),
    "commit-ai-flood": ("a flooding agent is always stopped, as a group", ("c", flood_stopped)),
}


# --- running a case -----------------------------------------------------------

def become_subreaper() -> None:
    """Adopt whatever a command leaves running.

    Both CLIs launch the notifier detached and exit without waiting for it, so
    a stub could still be starting when its log is read, and a case that fires
    a toast would compare two empty lists. As a subreaper this process inherits
    those orphans and can wait for them.
    """
    PR_SET_CHILD_SUBREAPER = 36
    if ctypes.CDLL(None, use_errno=True).prctl(PR_SET_CHILD_SUBREAPER, 1, 0, 0, 0) != 0:
        sys.exit("parity: could not become a subreaper; toasts would go unrecorded")


def reap_orphans() -> None:
    while True:
        try:
            os.waitpid(-1, 0)
        except ChildProcessError:
            return


def env_for(home: Path) -> dict:
    env = {k: v for k, v in os.environ.items() if not k.startswith("XDG_")}
    env.update(HOME=str(home), TZ=TZ, OMOIDE_NOW=NOW, OMOIDE_TEST_IDS="1", LC_ALL="C.UTF-8",
               PATH=f"{STUB_DIR}:{os.environ['PATH']}")
    return env


def run(argv: list[str], home: Path) -> tuple[int, str]:
    proc = subprocess.run(argv, env=env_for(home), capture_output=True,
                          text=True, timeout=120, stdin=subprocess.DEVNULL)
    reap_orphans()
    return proc.returncode, proc.stdout


def parse_stdout(text: str):
    lines = [line for line in text.splitlines() if line.strip()]
    try:
        return [json.loads(line) for line in lines]
    except json.JSONDecodeError:
        return {"unparsed": text}


def cell(value):
    """A JSON column compared as JSON: the reference wrote ', ' and ': '."""
    return json_or_text(value) if isinstance(value, str) else value


def dump_db(home: Path):
    path = home / ".local/share/omoide/memories.db"
    if not path.exists():
        return None
    conn = sqlite3.connect(path)
    out = {"user_version": conn.execute("PRAGMA user_version").fetchone()[0]}
    tables = conn.execute(
        "SELECT name, type, sql FROM sqlite_master ORDER BY type, name").fetchall()
    out["schema"] = [list(t) for t in tables]
    for name, kind, _ in tables:
        # FTS5's shadow tables hold its internal b-tree; the rows that matter
        # are compared through the tables they index.
        if kind != "table" or name.startswith("memories_fts_") or name.startswith("sqlite_"):
            continue
        rows = conn.execute(f'SELECT * FROM "{name}"').fetchall()
        out[name] = sorted(json.dumps([cell(v) for v in r], default=str, ensure_ascii=False)
                           for r in rows)
    conn.close()
    return out


def scrub(value, home: Path):
    """Each side runs in its own home, so absolute paths name different
    directories. Written as ~ they compare as what they are."""
    if isinstance(value, str):
        return value.replace(str(home), "~")
    if isinstance(value, list):
        return [scrub(v, home) for v in value]
    if isinstance(value, dict):
        return {k: scrub(v, home) for k, v in value.items()}
    return value


def read_json(path: Path):
    try:
        return json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return None


# How long a step took is the one thing two honest runs disagree on.
SECONDS = re.compile(r"seconds=[0-9.]+")


def side_effects(home: Path) -> dict:
    """Everything a command leaves behind besides the database."""
    data = home / ".local/share/omoide"
    state = home / ".local/state/omoide"
    files = []
    for root in (data, state):
        if root.exists():
            files += sorted(str(p.relative_to(home)) for p in root.rglob("*")
                            if p.is_file() and not p.name.startswith("memories.db")
                            and p.name not in ("index.json", "omoide.log"))
    calls = {}
    for name in STUBBED:
        log = home / f".stub-{name}.log"
        if log.exists():
            calls[name] = [normalize_call(name, json.loads(line))
                           for line in log.read_text().splitlines()]
            # Toasts are launched detached, so the order they are recorded in
            # is a race even within one run. Which toasts went out is not.
            if name == "omarchy-notification-send":
                calls[name].sort(key=lambda c: json.dumps(c, ensure_ascii=False))
    log = state / "omoide.log"
    return {
        "index": read_json(state / "index.json"),
        "config": read_json(home / ".config/omoide/config.json"),
        "log": [SECONDS.sub("seconds=N", line) for line in log.read_text().splitlines()]
               if log.exists() else [],
        "files": files,
        "calls": calls,
    }


def main() -> int:
    parser = argparse.ArgumentParser(description="C vs Python CLI parity")
    parser.add_argument("filter", nargs="?", default="")
    parser.add_argument("--ref", default=REFERENCE)
    parser.add_argument("--cc", default="clang")
    parser.add_argument("--sanitize", action="store_true",
                        help="build the C side with ASan and UBSan")
    parser.add_argument("--dump", action="store_true",
                        help="print what the C side did, to check a case tests something")
    args = parser.parse_args()

    global STUB_DIR
    become_subreaper()
    failed = 0
    with tempfile.TemporaryDirectory(prefix="omoide-parity-") as tmp:
        tmp = Path(tmp)
        STUB_DIR = tmp / "stubs"
        STUB_DIR.mkdir()
        (STUB_DIR / "stub").write_text(STUB)
        (STUB_DIR / "stub").chmod(0o755)
        for name in STUBBED:
            (STUB_DIR / name).symlink_to("stub")
        c_bin = build_c(args.cc, tmp, args.sanitize)
        py_bin = export_reference(args.ref, tmp)
        py = [sys.executable, str(py_bin)]

        for name, seeds, argv in CASES:
            if args.filter not in name:
                continue
            base = tmp / name / "base"
            base.mkdir(parents=True)
            (base / ".fixture.png").write_bytes(png(20, 10))
            for step in seeds:
                if callable(step):
                    step(base)
                else:
                    run(py + step, base)
            sides = {}
            for side, command in (("python", py), ("c", [str(c_bin)])):
                home = tmp / name / side
                shutil.copytree(base, home, symlinks=True)
                # The seed's own calls and log lines are not this case's.
                for leftover in home.glob(".stub-*.log"):
                    leftover.unlink()
                (home / ".local/state/omoide/omoide.log").unlink(missing_ok=True)
                code, stdout = run(command + argv, home)
                sides[side] = scrub({"exit": code, "stdout": parse_stdout(stdout),
                                     "db": dump_db(home), **side_effects(home)}, home)

            if args.dump:
                shown = {k: v for k, v in sides["c"].items() if k not in ("db", "index")}
                print(json.dumps(shown, ensure_ascii=False, indent=1))

            note = ""
            if name in EXPECTED:
                why, (kind, action) = EXPECTED[name]
                note = f"  (expected: {why})"
                if kind == "check":
                    problem = action(sides["python"], sides["c"])
                    if problem:
                        failed += 1
                        print(f"FAIL {name}: {problem}")
                    else:
                        print(f"ok   {name}{note}")
                    continue
                action(sides["c"])

            diffs = [key for key in sides["python"]
                     if sides["python"][key] != sides["c"][key]]
            if diffs:
                failed += 1
                print(f"FAIL {name}: {', '.join(diffs)} differ{note}")
                for key in diffs:
                    for side in ("python", "c"):
                        shown = json.dumps(sides[side][key], ensure_ascii=False)
                        print(f"  {side:>6} {key}: {shown[:900]}")
            else:
                print(f"ok   {name}{note}")

    print(f"\n{failed} failed" if failed else "\nall passed")
    return 1 if failed else 0


if __name__ == "__main__":
    raise SystemExit(main())
