# --- the reference -----------------------------------------------------------
#
# Patched in two places so both sides are deterministic: a clock override, and
# ids from a counter instead of uuid4. Each patch is asserted, so a reference
# whose code has moved fails loudly instead of leaving the sides out of step.

PATCHES = [
    ("def now() -> datetime:\n    return datetime.now(timezone.utc)\n",
     "def now() -> datetime:\n"
     "    pinned = os.environ.get('OMOIDE_NOW')\n"
     "    if pinned:\n"
     "        return datetime.fromisoformat(pinned.replace('Z', '+00:00'))\n"
     "    return datetime.now(timezone.utc)\n"),
    ('    stamp = now().strftime("%Y%m%dT%H%M%S")\n'
     '    return f"{prefix}{stamp}-{uuid.uuid4().hex[:12]}"\n',
     '    stamp = now().strftime("%Y%m%dT%H%M%S")\n'
     '    global _TEST_ID\n'
     '    _TEST_ID = globals().get("_TEST_ID", 0) + 1\n'
     '    return f"{prefix}{stamp}-{_TEST_ID:012x}"\n'),
]


def export_reference(ref: str, out: Path) -> Path:
    tree = out / "reference"
    tree.mkdir()
    archive = subprocess.run(["git", "archive", ref, "bin", "sql", "prompts"],
                             cwd=ROOT, check=True, capture_output=True).stdout
    subprocess.run(["tar", "-x", "-C", str(tree)], input=archive, check=True)
    script = tree / "bin/omoide"
    source = script.read_text()
    for original, patched in PATCHES:
        if original not in source:
            sys.exit(f"parity: {ref}:bin/omoide changed shape; update PATCHES:\n{original}")
        source = source.replace(original, patched)
    script.write_text(source)
    return script


# Later flags win, so these override build.rsp's -Os and -s. Fortify is off
# because ASan does the same job and the two warn about each other.
SANITIZE = ["-O1", "-g", "-fno-omit-frame-pointer", "-U_FORTIFY_SOURCE",
            "-fsanitize=address,undefined", "-fno-sanitize-recover=all"]


def build_c(cc: str, out: Path, sanitize: bool) -> Path:
    binary = out / "omoide-c"
    extra = SANITIZE if sanitize else []
    subprocess.run([cc, "@build.rsp", "-Werror", *extra, "-o", str(binary)],
                   cwd=ROOT / "cli", check=True)
    return binary


