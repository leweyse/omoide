                     "VALUES (?,?,?,?,?,?,?)", (bid, mid, pos, kind, json.dumps(payload), origin, edited))

    def item(iid, mid, kind, title, created, **cols):
        fields = {"id": iid, "memory_id": mid, "kind": kind, "title": title,
                  "created_at": created, **cols}
        conn.execute(f"INSERT INTO items ({', '.join(fields)}) VALUES "
                     f"({', '.join('?' * len(fields))})", tuple(fields.values()))

    def blob(mid, name, content):
        path = data / "blobs" / mid / name
