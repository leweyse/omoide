def at(minutes: int) -> str:
    """NOW shifted by some minutes, in the stored format."""
    base = datetime.fromisoformat(NOW.replace("Z", "+00:00"))
    return (base + timedelta(minutes=minutes)).strftime("%Y-%m-%dT%H:%M:%SZ")


def png(width: int, height: int) -> bytes:
    """A real, if blank, PNG, so ffprobe has something to measure."""
    def chunk(kind: bytes, data: bytes) -> bytes:
        body = kind + data
        return struct.pack(">I", len(data)) + body + struct.pack(">I", zlib.crc32(body))
    raw = b"".join(b"\x00" + b"\x00\x00\x00" * width for _ in range(height))
    return (b"\x89PNG\r\n\x1a\n"
            + chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0))
            + chunk(b"IDAT", zlib.compress(raw)) + chunk(b"IEND", b""))


def migrations_upto(version: int) -> str:
    files = sorted((ROOT / "sql/migrations").glob("*.sql"))
    return "".join(f.read_text() for f in files if int(f.name[:3]) <= version)


def seed_v1(home: Path) -> None:
    """A database left at schema v1, as an install from before 002 has."""
    db = home / ".local/share/omoide/memories.db"
    db.parent.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(db)
    conn.executescript(migrations_upto(1))
    conn.execute("PRAGMA user_version = 1")
    conn.commit()
    conn.close()


