def seed_library(home: Path) -> None:
    """A library with one of everything the commands look at.

    Run after `migrate`, so the schema is the CLI's own.
    """
    data = home / ".local/share/omoide"
    conn = sqlite3.connect(data / "memories.db")
    conn.execute("PRAGMA foreign_keys = ON")

    def memory(mid, created, *, status="ready", ai="ok", title=None, lede=None, ocr=None):
        conn.execute("INSERT INTO memories (id, created_at, updated_at, title, lede, "
                     "ocr_text, status, ai_status) VALUES (?,?,?,?,?,?,?,?)",
                     (mid, created, created, title, lede, ocr, status, ai))

    def block(bid, mid, pos, kind, payload, origin="ai", edited=0):
        conn.execute("INSERT INTO blocks (id, memory_id, position, type, payload, origin, edited) "
                     "VALUES (?,?,?,?,?,?,?)", (bid, mid, pos, kind, json.dumps(payload), origin, edited))

    def item(iid, mid, kind, title, created, **cols):
        fields = {"id": iid, "memory_id": mid, "kind": kind, "title": title,
                  "created_at": created, **cols}
        conn.execute(f"INSERT INTO items ({', '.join(fields)}) VALUES "
                     f"({', '.join('?' * len(fields))})", tuple(fields.values()))

    def blob(mid, name, content):
        path = data / "blobs" / mid / name
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_bytes(content)
        return f"blobs/{mid}/{name}"

    # A screenshot from GitHub, measured, in a collection, with to-dos.
    memory("m-shot", at(-600), title="Café José – release notes",
           lede="Diacritics and a dash", ocr="Release v2.0 notes for bandcamp")
