def build_c(cc: str, out: Path, sanitize: bool) -> Path:
    binary = out / "omoide-c"
    extra = SANITIZE if sanitize else []
    subprocess.run([cc, "@build.rsp", "-Werror", *extra, "-o", str(binary)],
                   cwd=ROOT / "cli", check=True)
    return binary


