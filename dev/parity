def many_items(todos: int, events: int):
    """One memory holding more to-dos and events than any page, so a case shows
    that counts and pages hold past the sizes a view asks for. One past the caps
    the index once had, 200 to-dos and 50 events, is enough."""
    def apply(home: Path) -> None:
        conn = sqlite3.connect(home / ".local/share/omoide/memories.db")
        conn.execute("INSERT INTO memories (id, created_at, updated_at, title, status, ai_status) "
                     "VALUES ('m-many', '2026-09-20T10:00:00Z', '2026-09-20T10:00:00Z', 'Many', 'ready', 'ok')")
        for n in range(todos):
            conn.execute("INSERT INTO items (id, memory_id, kind, title, due_at, created_at) "
                         "VALUES (?, 'm-many', 'todo', ?, ?, ?)",
                         (f"t-{n:03d}", f"To-do {n}", f"2026-10-{1 + n % 28:02d}T09:00:00Z",
                          f"2026-09-{1 + n % 25:02d}T10:{n % 60:02d}:00Z"))
        for n in range(events):
            conn.execute("INSERT INTO items (id, memory_id, kind, title, starts_at, created_at) "
                         "VALUES (?, 'm-many', 'event', ?, ?, '2026-09-20T10:00:00Z')",
                         (f"e-{n:03d}", f"Event {n}", f"2026-11-{1 + n % 28:02d}T18:{n % 60:02d}:00Z"))
        conn.commit()
        conn.close()
    return apply


