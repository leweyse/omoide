def normalize_toast(argv: list[str]) -> dict:
    """One notification, independent of argument order.

    The reference passed --exec first, as one quoted string, which the current
    omarchy-notification-send rejects; the C side passes it last, as words.
    Both are read back into the same shape so the rest still has to match.
    """
    out: dict = {"options": {}, "text": [], "exec": None}
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg == "--exec":
            rest = argv[i + 1:]
            if rest and " " in rest[0]:
                out["exec"], out["text"] = shlex.split(rest[0]), out["text"] + rest[1:]
            else:
                out["exec"] = rest
            break
        if arg in ("-g", "-u", "-i", "-t", "-r", "--image", "--app-name"):
            out["options"][arg] = argv[i + 1]
            i += 2
            continue
        out["text"].append(arg)
        i += 1
    if out["exec"]:
        out["exec"] = [json_or_text(a) for a in out["exec"]]
    return out


def json_or_text(value):
    """A JSON argument compared as what it says rather than how it is spaced."""
    if isinstance(value, str) and value[:1] in ("{", "["):
        try:
            return json.loads(value)
        except json.JSONDecodeError:
            pass
    return value


def normalize_call(name: str, call: dict) -> dict:
    if name == "omarchy-notification-send":
        return normalize_toast(call["argv"])
    call = dict(call, argv=[json_or_text(a) for a in call["argv"]])
    if "stdin" in call and "\n\nINPUT:\n" in call["stdin"]:
        template, context = call["stdin"].split("\n\nINPUT:\n", 1)
        call["stdin"] = {"template_len": len(template), "input": json.loads(context)}
    if "OPENCODE_CONFIG_CONTENT" in call.get("env", {}):
        call["env"]["OPENCODE_CONFIG_CONTENT"] = json.loads(call["env"]["OPENCODE_CONFIG_CONTENT"])
    return call


