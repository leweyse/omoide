def become_subreaper() -> None:
    """Adopt whatever a command leaves running.

    Both CLIs launch the notifier detached and exit without waiting for it, so
    a stub could still be starting when its log is read, and a case that fires
    a toast would compare two empty lists. As a subreaper this process inherits
    those orphans and can wait for them.
    """
    PR_SET_CHILD_SUBREAPER = 36
    if ctypes.CDLL(None, use_errno=True).prctl(PR_SET_CHILD_SUBREAPER, 1, 0, 0, 0) != 0:
        sys.exit("parity: could not become a subreaper; toasts would go unrecorded")


def reap_orphans() -> None:
    while True:
        try:
            os.waitpid(-1, 0)
        except ChildProcessError:
            return


def env_for(home: Path) -> dict:
    env = {k: v for k, v in os.environ.items() if not k.startswith("XDG_")}
    env.update(HOME=str(home), TZ=TZ, OMOIDE_NOW=NOW, OMOIDE_TEST_IDS="1", LC_ALL="C.UTF-8",
               PATH=str(STUB_DIR))
    return env


def run(argv: list[str], home: Path) -> tuple[int, str]:
    proc = subprocess.run(argv, env=env_for(home), capture_output=True,
                          text=True, timeout=120, stdin=subprocess.DEVNULL)
    reap_orphans()
    return proc.returncode, proc.stdout


def parse_stdout(text: str):
    lines = [line for line in text.splitlines() if line.strip()]
    try:
        return [json.loads(line) for line in lines]
    except json.JSONDecodeError:
        return {"unparsed": text}


def cell(value):
    """A JSON column compared as JSON, so spacing is not a difference."""
    return json_or_text(value) if isinstance(value, str) else value


def dump_db(home: Path):
    path = home / ".local/share/omoide/memories.db"
    if not path.exists():
        return None
    conn = sqlite3.connect(path)
    out = {"user_version": conn.execute("PRAGMA user_version").fetchone()[0]}
    tables = conn.execute(
        "SELECT name, type, sql FROM sqlite_master ORDER BY type, name").fetchall()
    # The schema is the same in almost every case, so a fixture holds its digest;
    # --dump shows the text when a digest changes.
    schema = json.dumps([list(t) for t in tables], ensure_ascii=False)
    out["schema"] = schema if DUMPING else "sha256:" + hashlib.sha256(schema.encode()).hexdigest()
    for name, kind, _ in tables:
        # FTS5's shadow tables hold its internal b-tree; the rows that matter
        # are compared through the tables they index.
        if kind != "table" or name.startswith("memories_fts_") or name.startswith("sqlite_"):
            continue
        rows = conn.execute(f'SELECT * FROM "{name}"').fetchall()
        out[name] = sorted(json.dumps([cell(v) for v in r], default=str, ensure_ascii=False)
                           for r in rows)
    conn.close()
    return out


def scrub(value, home: Path):
    """Each side runs in its own home, so absolute paths name different
    directories. Written as ~ they compare as what they are."""
    if isinstance(value, str):
        return value.replace(str(home), "~")
    if isinstance(value, list):
        return [scrub(v, home) for v in value]
    if isinstance(value, dict):
        return {k: scrub(v, home) for k, v in value.items()}
    return value


def read_json(path: Path):
    try:
        return json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return None


# How long a step took is the one thing two honest runs disagree on.
SECONDS = re.compile(r"seconds=[0-9.]+")


def pulled_index(cli: list[str], home: Path):
    """What the shell would render after this command: `omoide index`, run in a
    copy of the home so the pull itself leaves nothing in the case."""
    if not (home / ".local/share/omoide/memories.db").exists():
        return None
    copy = home.parent / f"{home.name}.pull"
    shutil.copytree(home, copy, symlinks=True)
    try:
        code, stdout = run(cli + ["index"], copy)
        return scrub(json.loads(stdout), copy) if code == 0 else None
    finally:
        shutil.rmtree(copy)


def side_effects(cli: list[str], home: Path) -> dict:
    """Everything a command leaves behind besides the database."""
    data = home / ".local/share/omoide"
    state = home / ".local/state/omoide"
    files = []
    for root in (data, state):
        if root.exists():
            files += sorted(str(p.relative_to(home)) for p in root.rglob("*")
                            if p.is_file() and not p.name.startswith("memories.db")
                            and p.name != "omoide.log")
    calls = {}
    for name in STUBBED:
        log = home / f".stub-{name}.log"
        if log.exists():
            calls[name] = [normalize_call(name, json.loads(line))
                           for line in log.read_text().splitlines()]
            # Toasts are launched detached, so the order they are recorded in
            # is a race even within one run. Which toasts went out is not.
            if name == "omarchy-notification-send":
                calls[name].sort(key=lambda c: json.dumps(c, ensure_ascii=False))
    log = state / "omoide.log"
    return {
        "index": pulled_index(cli, home),
        "config": read_json(home / ".config/omoide/config.json"),
        "log": [SECONDS.sub("seconds=N", line) for line in log.read_text().splitlines()]
               if log.exists() else [],
        "files": files,
        "calls": calls,
    }


CLI: list[str] = []            # set in main()
WORK: Path | None = None       # set in main()


def seeded(seeds, home: Path) -> None:
    """A home as `seeds` leave it, with the seeds' own traces removed."""
    home.mkdir(parents=True)
    (home / ".fixture.png").write_bytes(png(20, 10))
    for step in seeds:
        if callable(step):
            step(home)
        else:
            run(CLI + step, home)
    # The seed's own calls and log lines are not this case's.
    for leftover in home.glob(".stub-*.log"):
        leftover.unlink()
    (home / ".local/state/omoide/omoide.log").unlink(missing_ok=True)


def template_of(index: int) -> Path:
    """Where the seeded home for case `index`'s seed list is kept. Cases that
    share a list share one template, built once and copied."""
    return WORK / "seeded" / str(SEED_LISTS.index(CASES[index][1]))


def build_template(key: int) -> None:
    seeded(SEED_LISTS[key], WORK / "seeded" / str(key))


def run_case(index: int):
    """One case in its own home, returning (name, result). Everything it touches
    is under WORK/<name>, so cases can run side by side. The home starts as a
    copy of its seed list's template, which nothing in it can tell apart from a
    fresh seeding: the seeds are deterministic, and the index pull already runs
    in a copied home."""
    name, _seeds, argv = CASES[index]
    home = WORK / name
    shutil.copytree(template_of(index), home, symlinks=True)
    code, stdout = run(CLI + argv, home)
    return name, scrub({"exit": code, "stdout": parse_stdout(stdout),
                        "db": dump_db(home), **side_effects(CLI, home)}, home)


# Each distinct seed list: cases whose lists are equal share a template, since
# equal lists run the same steps. Set in main() for the cases chosen.
SEED_LISTS: list = []


def run_cases(chosen: list[int], jobs: int):
    """Each chosen case's (name, result), in CASES order.

    In worker processes, not threads: every run ends by reaping whatever the
    command left behind with waitpid(-1), which would take another thread's
    child. A worker is its own subreaper, since fork does not carry the setting,
    and runs one case at a time. Forked rather than spawned, because the seeds
    are closures that cannot be sent to a fresh interpreter."""
    keys = list(range(len(SEED_LISTS)))
    if jobs <= 1 or len(chosen) <= 1:
        for key in keys:
            build_template(key)
        for index in chosen:
            yield run_case(index)
        return
    context = multiprocessing.get_context("fork")
    with context.Pool(min(jobs, len(chosen)), initializer=become_subreaper) as pool:
        # Every template first, then the cases that copy them.
        pool.map(build_template, keys)
        yield from pool.imap(run_case, chosen)


def fixture_path(name: str) -> Path:
    return FIXTURES / f"{name}.json"


def encode(result: dict) -> str:
    return json.dumps(result, ensure_ascii=False, indent=1, sort_keys=True) + "\n"


def main() -> int:
    parser = argparse.ArgumentParser(description="CLI behavior against recorded fixtures")
    parser.add_argument("filter", nargs="?", default="")
    parser.add_argument("--cc", default="clang")
    parser.add_argument("--sanitize", action="store_true",
                        help="build the CLI with ASan and UBSan")
    parser.add_argument("--record", action="store_true",
                        help="rewrite the selected fixtures from what the CLI does now")
    parser.add_argument("--dump", action="store_true",
                        help="print what the CLI did, to check a case tests something")
    parser.add_argument("--jobs", type=int, default=os.cpu_count() or 1,
                        help="cases run at once; 1 runs them one after another")
    args = parser.parse_args()

    global STUB_DIR, DUMPING, CLI, WORK
    DUMPING = args.dump and not args.record
    become_subreaper()
    failed = 0
    names = [name for name, _, _ in CASES]
    if len(names) != len(set(names)):
        sys.exit("parity: two cases share a name")
    if not args.filter and not args.record:
        known = {fixture_path(name) for name in names}
        for orphan in sorted(set(FIXTURES.glob("*.json")) - known):
            failed += 1
            print(f"FAIL {orphan.stem}: a fixture with no case; delete it or restore the case")

    with tempfile.TemporaryDirectory(prefix="omoide-parity-") as tmp:
        tmp = Path(tmp)
        STUB_DIR = tmp / "stubs"
        STUB_DIR.mkdir()
        # By absolute path: nothing else is on PATH to find python3 with.
        (STUB_DIR / "stub").write_text(STUB.replace("#!/usr/bin/env python3", f"#!{sys.executable}", 1))
        (STUB_DIR / "stub").chmod(0o755)
        for name in STUBBED:
            (STUB_DIR / name).symlink_to("stub")
        for name in REAL:
            found = shutil.which(name)
            if not found:
                sys.exit(f"dev/parity: {name} is not installed, and cases need it")
            (STUB_DIR / name).symlink_to(found)
        CLI = [str(build_c(args.cc, tmp, args.sanitize))]
        WORK = tmp

        chosen = [i for i, (name, _, _) in enumerate(CASES) if args.filter in name]
        for i in chosen:
            if CASES[i][1] not in SEED_LISTS:
                SEED_LISTS.append(CASES[i][1])
        for name, result in run_cases(chosen, args.jobs):
            if args.dump:
                print(json.dumps(result, ensure_ascii=False, indent=1))

            path = fixture_path(name)
            if args.record:
                FIXTURES.mkdir(exist_ok=True)
                before = path.read_text() if path.exists() else None
                path.write_text(encode(result))
                print(f"{'same' if before == encode(result) else 'rec '} {name}")
                continue
            if not path.exists():
                failed += 1
                print(f"FAIL {name}: no fixture; review --dump, then --record {name}")
                continue
            expected = json.loads(path.read_text())
            diffs = [key for key in sorted(set(expected) | set(result))
                     if expected.get(key) != result.get(key)]
            if diffs:
                failed += 1
                print(f"FAIL {name}: {', '.join(diffs)} differ")
                for key in diffs:
                    for label, side in (("fixture", expected), ("now", result)):
                        shown = json.dumps(side.get(key), ensure_ascii=False)
                        print(f"  {label:>7} {key}: {shown[:900]}")
            else:
                print(f"ok   {name}")

    print(f"\n{failed} failed" if failed else "\nall passed")
    return 1 if failed else 0


if __name__ == "__main__":
    raise SystemExit(main())
