    block("b-src2", "m-note", 0, "source", {"url": "https://www.github.com/z", "domain": "github.com"})

    # A voice memo whose image was never measured: reindex backfills it.
    memory("m-voice", at(-200), title="Voice memo", ai="failed")
    conn.execute("INSERT INTO attachments (id, memory_id, kind, rel_path) "
                 "VALUES ('a-voice', 'm-voice', 'audio', 'blobs/m-voice/memo.ogg')")
    rel = blob("m-voice", "frame.png", png(4, 3))
    conn.execute("INSERT INTO attachments (id, memory_id, kind, rel_path) "
                 "VALUES ('a-frame', 'm-voice', 'image', ?)", (rel,))

    # An enrichment with no process behind it: the sweep marks it failed.
    memory("m-stalled", at(-100), title="Stalled", ai="pending")
    # Drafts: one long abandoned, one still on screen, one with its picture.
    memory("m-old-draft", at(-60), status="draft", ai="none")
    blob("m-old-draft", "capture.png", png(2, 2))
    memory("m-new-draft", at(-2), status="draft", ai="none")
    blob("m-new-draft", "capture.png", png(2, 2))
    memory("m-shot-draft", at(-1), status="draft", ai="none")
    rel = blob("m-shot-draft", "capture.png", png(12, 6))
    conn.execute("INSERT INTO attachments (id, memory_id, kind, rel_path, mime, bytes, width, "
                 "height) VALUES ('a-draft', 'm-shot-draft', 'image', ?, 'image/png', 99, 12, 6)",
                 (rel,))

    for mid, tag in [("m-shot", "release"), ("m-note", "release"), ("m-voice", "release"),
                     ("m-shot", "work"), ("m-note", "work"), ("m-shot", "zeta")]:
        conn.execute("INSERT INTO tags (memory_id, tag) VALUES (?,?)", (mid, tag))

    conn.execute("INSERT INTO collections (id, name, created_at) VALUES ('c-1', 'Reading', ?)", (at(-500),))
    conn.execute("INSERT INTO collections (id, name, created_at) VALUES ('c-2', 'Empty', ?)", (at(-500),))
    conn.execute("INSERT INTO memory_collections (memory_id, collection_id) VALUES ('m-shot', 'c-1')")
