    conn.execute("INSERT INTO links (from_id, to_id, created_at) VALUES ('m-note', 'm-shot', ?)", (at(-50),))

    item("t-today", "m-shot", "todo", "Ship it", at(-590), due_at=at(300))
    item("t-overdue", "m-shot", "todo", "Overdue thing", at(-580), due_at=at(-120))
