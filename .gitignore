# Python bytecode. bin/omoide is a script, not a package -- these only ever
# appear because something imported or byte-compiled it, and one already got
# committed once.
__pycache__/
*.py[cod]

# Rollback and merge leftovers. The plugin deliberately keeps none of these in
# its own tree (that is part of the clean-install contract), so anything here is
# a local accident.
*.bak
*.bak.*
*.orig
*.rej
*~
.*.sw[a-p]

# Qt caches, in case a tool is ever pointed at this directory. The real ones
# live in ~/.cache/quickshell/qmlcache.
*.qmlc
*.jsc

.DS_Store

# Demo scaffolding. Fills the real database with ~26 fake memories and takes
# them out again; useful locally, not something to ship. dev/check-types IS
# tracked -- it is the gate that catches QML type references qmllint misses.
dev/seed-demo
