# Rollback and merge leftovers. The plugin deliberately keeps none of these in
# its own tree (that is part of the clean-install contract), so anything here is
# a local accident.
*.bak
*.bak.*
*.orig
*.rej
*~
.*.sw[a-p]

# The changesets CLI, installed by pnpm. package.json and pnpm-lock.yaml are
# tracked; the packages themselves are not.
node_modules/

# Python bytecode. The dev/ scripts write none, and none belongs here.
__pycache__/

# Qt caches, in case a tool is ever pointed at this directory. The real ones
# live in ~/.cache/quickshell/qmlcache.
*.qmlc
*.jsc

.DS_Store

# Demo scaffolding: fills the real database with fake memories and takes them
# out again. Local only; every other script in dev/ is tracked.
dev/seed-demo

# Claude Code per-machine settings, and the .claude/skills link dev/link-skills
# makes, which omarchy plugin validate would refuse in a clone.
.claude/skills
.claude/settings.local.json
.claude/worktrees/
